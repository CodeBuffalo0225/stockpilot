# Required
ANTHROPIC_API_KEY=
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_REPORT_DATABASE_ID=
# Email via Resend (free 3k/mo — sign up at resend.com, copy API key)
RESEND_API_KEY=
REPORT_EMAIL=tsm5110@gmail.com
# Optional: override once you verify a domain. Defaults to Resend sandbox sender.
# REPORT_FROM=StockPilot <reports@yourdomain.com>

# Free — sign up at financialmodelingprep.com (250 req/day free)
FMP_API_KEY=

# Optional
SCRAPER_DEBUG=false

# Public subscriber brief (lib/mailer-public.ts, step 10b). Skips with needs_key
# / data_unlicensed until both gates are met.
BUTTONDOWN_API_KEY=
# Set to "true" ONLY once Agent 1 news + price data come from sources licensed
# for public display (Perplexity scraping and Yahoo are not).
PUBLIC_DATA_LICENSED=
# draft (default: you review + send in Buttondown) | send
PUBLIC_SEND_MODE=draft
